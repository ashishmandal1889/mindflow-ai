# Cloud Run & Server Configuration
PORT=8080
NODE_ENV=development

# Google Cloud Secret Manager or direct API Key
GEMINI_API_KEY=your_gemini_api_key_here
GCP_PROJECT_ID=your-gcp-project-id
GEMINI_SECRET_NAME=GEMINI_API_KEY

# Firebase Client & Admin Configuration
FIREBASE_API_KEY=AIzaSyExampleKey
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Optional: Allow simulated dev user for local testing without Firebase credentials
ALLOW_ANONYMOUS_DEV=true
